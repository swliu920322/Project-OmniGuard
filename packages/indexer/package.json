{
  "name": "@omnidocs/indexer",
  "version": "1.0.0",
  "description": "OmniDocs build-time CLI — scan markdown, validate frontmatter against @omnidocs/schema, emit docs-manifest.json + relation-graph.json.",
  "type": "module",
  "bin": {
    "omnidocs": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "import": "./dist/cli.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test dist/**/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "docs": "node dist/cli.js"
  },
  "dependencies": {
    "@omnidocs/schema": "^1.0.0",
    "gray-matter": "^4.0.3"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "typescript": "^5.4.5"
  }
}